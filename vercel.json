{
  "headers": [
    {
      "source": "/assets/(.*\\.(?:glb|mp4|webm|mp3))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*\\.(?:png|jpg|jpeg|pdf|svg|webp))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
